{
  "compilerOptions": {
    "module": "NodeNext",
    "rootDir": "src",
    "types": ["node"],
    "target": "ES2020",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "strict": true
  },
  "include": ["src/**/*.ts"]
}

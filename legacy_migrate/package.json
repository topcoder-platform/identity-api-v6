{
  "name": "identity-migration",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "generate": "prisma generate --schema=prisma/target.schema.prisma && prisma generate --schema=prisma/source-auth.schema.prisma && prisma generate --schema=prisma/source-identity.schema.prisma",
    "migrate": "node -r ts-node/register src/migrate.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client-runtime-utils": "7.10.1",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.4.5",
    "mysql2": "3.23.1",
    "ts-node": "^10.9.2"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
